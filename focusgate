#!/usr/bin/env python3
"""focusgate status|stop|start — stopping requires a typing challenge (friction against impulse)."""
import os, random, string, subprocess, sys, time

def sh(*a): return subprocess.run(a).returncode

cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
if cmd == "status":
    sys.exit(sh("systemctl", "status", "focusgate", "--no-pager"))
if cmd == "start":
    sys.exit(sh("systemctl", "start", "focusgate"))
if cmd == "stop":
    if os.geteuid() != 0: sys.exit("run with sudo")
    print("Stopping FocusGate re-enables the distracting parts of YouTube/Instagram.")
    print("Wait 60 seconds, then type the text below exactly.")
    time.sleep(60)
    words = ["".join(random.choices(string.ascii_lowercase, k=random.randint(4, 8))) for _ in range(25)]
    challenge = " ".join(words)
    print("\n" + challenge + "\n")
    if input("> ").strip() != challenge: sys.exit("Mismatch. Still blocked.")
    sys.exit(sh("systemctl", "stop", "focusgate"))
sys.exit("usage: focusgate status|start|stop")
